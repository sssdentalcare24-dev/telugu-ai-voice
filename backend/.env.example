# Copy to backend/.env and fill in. NEVER commit the real .env file.
# Every secret lives here on the server - none goes into the Flutter app.

# ---- General -------------------------------------------------------------
APP_ENV=development                 # development | production
# Signs short-lived audio download links. Production: 32+ random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
DOWNLOAD_URL_TTL_SECONDS=900
# Web app origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ---- Authentication --------------------------------------------------------
# dev      = local testing; the app sends an X-Dev-User header (refused in production)
# firebase = real sign-in; the app sends a Firebase ID token
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Service-account JSON path. Leave empty on Google Cloud to use default credentials.
FIREBASE_CREDENTIALS_FILE=

# ---- Storage (local disk now; Cloud Storage + Firestore arrive in Stage 7) ----
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/audio
METADATA_BACKEND=sqlite
SQLITE_PATH=./data/telugu_voice.db

# ---- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_AUDIO_SECONDS=300
MAX_TTS_CHARS=5000

# ---- AI providers --------------------------------------------------------------
VOICES_CONFIG_FILE=./config/voices.yaml
TTS_PROVIDERS=google,azure

# Google Cloud Text-to-Speech  [PAID - needs a Google Cloud project with billing]
GOOGLE_TTS_CREDENTIALS_FILE=
GOOGLE_TTS_API_KEY=

# Azure AI Speech  [PAID beyond the free tier]
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Recorded voice conversion (Stages 4-5)  [PAID]
VOICE_CONVERSION_PROVIDER=none      # none | elevenlabs (from Stage 4)
ELEVENLABS_API_KEY=
VC_TARGET_FEMALE_VOICE_ID=
VC_TARGET_MALE_VOICE_ID=

# Live streaming conversion (Stage 6). "none" = feature shown as unavailable.
LIVE_CONVERSION_PROVIDER=none
